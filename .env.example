# Local defaults used by the services (docker-compose.yml sets container-friendly values itself).

# catalog-service
DATABASE_URL=postgresql+psycopg2://beanboard:beanboard@localhost:5432/catalog

# reviews-service
MONGO_URL=mongodb://localhost:27017
MONGO_DB=reviews

# insights-service
CATALOG_SERVICE_URL=http://localhost:8001
REVIEWS_SERVICE_URL=http://localhost:8002

# all Python services (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
