# Local defaults used by the services (docker-compose.yml sets container-friendly values itself).

# catalog-service
DATABASE_URL=postgresql+psycopg2://beanboard:beanboard@localhost:5432/catalog

# reviews-service (also uses CATALOG_SERVICE_URL below)
MONGO_URL=mongodb://localhost:27017
MONGO_DB=reviews

# insights-service and reviews-service (CATALOG_SERVICE_URL is read by both)
CATALOG_SERVICE_URL=http://localhost:8001
REVIEWS_SERVICE_URL=http://localhost:8002

# insights-service and reviews-service: upstream HTTP timeout in seconds
REQUEST_TIMEOUT=5

# all Python services (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
